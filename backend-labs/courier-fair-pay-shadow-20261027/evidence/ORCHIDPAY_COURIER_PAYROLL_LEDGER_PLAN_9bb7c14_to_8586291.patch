index 0000000..7acc134
--- /dev/null
+++ b/app/schemas/courier_settlement.py
@@ -0,0 +1,127 @@
+from __future__ import annotations
+
+import re
+from datetime import datetime
+from typing import Literal
+
+from pydantic import BaseModel, Field, field_validator, model_validator
+
+HEX64 = re.compile(r"^[0-9a-f]{64}$")
+WEEK_KEY = re.compile(r"^\d{4}-W\d{2}$")
+
+
+class CourierSettlementIntent(BaseModel):
+    schema_version: Literal["ORCHIDPAY_COURIER_SETTLEMENT_INTENT_V0.1"] = (
+        "ORCHIDPAY_COURIER_SETTLEMENT_INTENT_V0.1"
+    )
+    mode: Literal["SHADOW"] = "SHADOW"
+    source_system: Literal["DELISHAFRICA_COURIER_FAIR_PAY"] = (
+        "DELISHAFRICA_COURIER_FAIR_PAY"
+    )
+
+    statement_id: str
+    courier_id: str
+    week_key: str
+    country_code: str
+    currency: str
+
+    policy_id: str
+    policy_hash: str
+    facts_hash: str
+    policy_validation_status: Literal["DRAFT", "LEGAL_REVIEW", "GREEN"]
+    production_eligible: bool = False
+
+    eligible_income_minor: int = Field(ge=0)
+    governing_floor_minor: int = Field(ge=0)
+    differential_due_minor: int = Field(ge=0)
+    gross_pay_due_minor: int = Field(ge=0)
+    tips_minor: int = Field(ge=0)
+    expense_reimbursements_minor: int = Field(ge=0)
+    total_cash_due_minor: int = Field(ge=0)
+
+    generated_at: datetime
+    evidence_refs: list[str] = Field(min_length=1)
+    warnings: list[str] = Field(default_factory=list)
+
+    @field_validator("statement_id", "policy_hash", "facts_hash")
+    @classmethod
+    def validate_hash(cls, value: str) -> str:
+        clean = str(value).strip().lower()
+        if not HEX64.fullmatch(clean):
+            raise ValueError("expected 64-char lowercase SHA-256 hex")
+        return clean
+
+    @field_validator("courier_id", "policy_id")
+    @classmethod
+    def validate_required_text(cls, value: str) -> str:
+        clean = str(value).strip()
+        if not clean:
+            raise ValueError("required text")
+        return clean
+
+    @field_validator("week_key")
+    @classmethod
+    def validate_week_key(cls, value: str) -> str:
+        clean = str(value).strip()
+        if not WEEK_KEY.fullmatch(clean):
+            raise ValueError("invalid ISO week key")
+        return clean
+
+    @field_validator("country_code")
+    @classmethod
+    def normalize_country(cls, value: str) -> str:
+        clean = str(value).strip().upper()
+        if not re.fullmatch(r"[A-Z]{2}", clean):
+            raise ValueError("invalid country code")
+        return clean
+
+    @field_validator("currency")
+    @classmethod
+    def normalize_currency(cls, value: str) -> str:
+        clean = str(value).strip().upper()
+        if not re.fullmatch(r"[A-Z]{3}", clean):
+            raise ValueError("invalid currency")
+        return clean
+
+    @field_validator("generated_at")
+    @classmethod
+    def require_timezone(cls, value: datetime) -> datetime:
+        if value.tzinfo is None or value.utcoffset() is None:
+            raise ValueError("generated_at must be timezone-aware")
+        return value
+
+    @field_validator("evidence_refs")
+    @classmethod
+    def normalize_evidence(cls, values: list[str]) -> list[str]:
+        clean = sorted({str(value).strip() for value in values if str(value).strip()})
+        if not clean:
+            raise ValueError("at least one evidence ref is required")
+        return clean
+
+    @field_validator("warnings")
+    @classmethod
+    def normalize_warnings(cls, values: list[str]) -> list[str]:
+        return sorted({str(value).strip() for value in values if str(value).strip()})
+
+    @model_validator(mode="after")
+    def validate_amounts(self):
+        if self.differential_due_minor > self.gross_pay_due_minor:
+            raise ValueError("differential cannot exceed gross pay")
+        if self.governing_floor_minor > self.gross_pay_due_minor:
+            raise ValueError("gross pay cannot be below governing floor")
+        expected_total = (
+            self.gross_pay_due_minor
+            + self.tips_minor
+            + self.expense_reimbursements_minor
+        )
+        if self.total_cash_due_minor != expected_total:
+            raise ValueError("total cash due mismatch")
+        return self
+
+
+class CourierSettlementReceipt(BaseModel):
+    statement_id: str
+    intent_hash: str
+    status: Literal["SHADOW_RECEIVED"] = "SHADOW_RECEIVED"
+    idempotent_replay: bool
+    production_execution: Literal[False] = False
diff --git a/app/services/courier_payroll_ledger_plan.py b/app/services/courier_payroll_ledger_plan.py
new file mode 100644
index 0000000..776e772
--- /dev/null
+++ b/app/services/courier_payroll_ledger_plan.py
@@ -0,0 +1,178 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+from app.schemas.courier_settlement import CourierSettlementIntent
+
+
+@dataclass(frozen=True)
+class LedgerPlanEntry:
+    account_id: str
+    direction: str
+    amount_minor: int
+    currency: str
+
+
+@dataclass(frozen=True)
+class LedgerPlanTx:
+    component: str
+    idempotency_key: str
+    external_type: str
+    external_id: str
+    amount_minor: int
+    currency: str
+    entries: tuple[LedgerPlanEntry, LedgerPlanEntry]
+    metadata: dict[str, Any]
+    execution_allowed: bool = False
+
+
+@dataclass(frozen=True)
+class CourierPayrollLedgerPlan:
+    statement_id: str
+    courier_party_id: str
+    courier_payable_account_id: str
+    transactions: tuple[LedgerPlanTx, ...]
+    total_planned_minor: int
+    production_execution: bool = False
+
+
+@dataclass(frozen=True)
+class CourierPayrollSystemAccounts:
+    gross_clearing_account_id: str
+    tip_clearing_account_id: str
+    expense_clearing_account_id: str
+
+
+def _required(value: str, field: str) -> str:
+    clean = str(value or "").strip()
+    if not clean:
+        raise ValueError(f"ORCHIDPAY_COURIER_LEDGER_{field.upper()}_REQUIRED")
+    return clean
+
+
+def _tx(
+    *,
+    intent: CourierSettlementIntent,
+    component: str,
+    amount_minor: int,
+    debit_account_id: str,
+    courier_payable_account_id: str,
+) -> LedgerPlanTx | None:
+    if amount_minor < 0:
+        raise ValueError("ORCHIDPAY_COURIER_LEDGER_NEGATIVE_AMOUNT")
+    if amount_minor == 0:
+        return None
+    debit = _required(debit_account_id, f"{component}_debit_account")
+    credit = _required(courier_payable_account_id, "courier_payable_account")
+    metadata = {
+        "source_system": intent.source_system,
+        "schema_version": intent.schema_version,
+        "statement_id": intent.statement_id,
+        "policy_id": intent.policy_id,
+        "policy_hash": intent.policy_hash,
+        "facts_hash": intent.facts_hash,
+        "courier_id": intent.courier_id,
+        "week_key": intent.week_key,
+        "country_code": intent.country_code,
+        "component": component,
+        "policy_validation_status": intent.policy_validation_status,
+        "production_eligible": intent.production_eligible,
+    }
+    external_type = f"courier_payroll_statement_{component}"
+    return LedgerPlanTx(
+        component=component,
+        idempotency_key=f"courier_payroll:{intent.statement_id}:{component}",
+        external_type=external_type,
+        external_id=intent.statement_id,
+        amount_minor=amount_minor,
+        currency=intent.currency,
+        entries=(
+            LedgerPlanEntry(
+                account_id=debit,
+                direction="DEBIT",
+                amount_minor=amount_minor,
+                currency=intent.currency,
+            ),
+            LedgerPlanEntry(
+                account_id=credit,
+                direction="CREDIT",
+                amount_minor=amount_minor,
+                currency=intent.currency,
+            ),
+        ),
+        metadata=metadata,
+        execution_allowed=False,
+    )
+
+
+def build_courier_payroll_ledger_plan(
+    intent: CourierSettlementIntent,
+    *,
+    courier_party_id: str,
+    courier_payable_account_id: str,
+    system_accounts: CourierPayrollSystemAccounts,
+) -> CourierPayrollLedgerPlan:
+    """Builds an auditable plan only. This function cannot post ledger entries."""
+    party_id = _required(courier_party_id, "courier_party_id")
+    payable = _required(
+        courier_payable_account_id,
+        "courier_payable_account_id",
+    )
+
+    if intent.mode != "SHADOW":
+        raise ValueError("ORCHIDPAY_COURIER_LEDGER_SHADOW_ONLY")
+
+    candidates = [
+        _tx(
+            intent=intent,
+            component="gross",
+            amount_minor=intent.gross_pay_due_minor,
+            debit_account_id=system_accounts.gross_clearing_account_id,
+            courier_payable_account_id=payable,
+        ),
+        _tx(
+            intent=intent,
+            component="tips",
+            amount_minor=intent.tips_minor,
+            debit_account_id=system_accounts.tip_clearing_account_id,
+            courier_payable_account_id=payable,
+        ),
+        _tx(
+            intent=intent,
+            component="expense",
+            amount_minor=intent.expense_reimbursements_minor,
+            debit_account_id=system_accounts.expense_clearing_account_id,
+            courier_payable_account_id=payable,
+        ),
+    ]
+    transactions = tuple(tx for tx in candidates if tx is not None)
+
+    total = sum(tx.amount_minor for tx in transactions)
+    if total != intent.total_cash_due_minor:
+        raise ValueError("ORCHIDPAY_COURIER_LEDGER_TOTAL_MISMATCH")
+
+    for tx in transactions:
+        debit = sum(
+            entry.amount_minor
+            for entry in tx.entries
+            if entry.direction == "DEBIT"
+        )
+        credit = sum(
+            entry.amount_minor
+            for entry in tx.entries
+            if entry.direction == "CREDIT"
+        )
+        if debit != credit or debit != tx.amount_minor:
+            raise ValueError("ORCHIDPAY_COURIER_LEDGER_UNBALANCED_PLAN")
+        if any(entry.currency != intent.currency for entry in tx.entries):
+            raise ValueError("ORCHIDPAY_COURIER_LEDGER_CURRENCY_MISMATCH")
+
+    return CourierPayrollLedgerPlan(
+        statement_id=intent.statement_id,
+        courier_party_id=party_id,
+        courier_payable_account_id=payable,
+        transactions=transactions,
+        total_planned_minor=total,
+        production_execution=False,
+    )
diff --git a/app/services/courier_settlement_service.py b/app/services/courier_settlement_service.py
new file mode 100644
index 0000000..08dd6fc
--- /dev/null
+++ b/app/services/courier_settlement_service.py
@@ -0,0 +1,175 @@
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from app.schemas.courier_settlement import (
+    CourierSettlementIntent,
+    CourierSettlementReceipt,
+)
+
+
+class CourierSettlementConflict(RuntimeError):
+    pass
+
+
+class CourierSettlementIntegrityError(RuntimeError):
+    pass
+
+
+def canonical_intent_json(intent: CourierSettlementIntent) -> str:
+    payload = intent.model_dump(mode="json")
+    # Transport/envelope time may legitimately differ across retries of the same
+    # immutable weekly statement. It must not create a false economic conflict.
+    payload.pop("generated_at", None)
+    return json.dumps(
+        payload,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+    )
+
+
+def intent_hash(intent: CourierSettlementIntent) -> str:
+    return hashlib.sha256(canonical_intent_json(intent).encode("utf-8")).hexdigest()
+
+
+@dataclass(frozen=True)
+class StoredSettlementIntent:
+    statement_id: str
+    intent_hash: str
+    intent: dict[str, Any]
+    status: str
+
+
+class ShadowCourierSettlementIntentStore:
+    def __init__(self, root_dir: str):
+        self.root_dir = Path(root_dir).expanduser().resolve()
+        self.root_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
+        os.chmod(self.root_dir, 0o700)
+        self.file_path = self.root_dir / "settlement-intents.ndjson"
+        if not self.file_path.exists():
+            fd = os.open(self.file_path, os.O_CREAT | os.O_WRONLY, 0o600)
+            os.close(fd)
+        os.chmod(self.file_path, 0o600)
+        self._records: dict[str, StoredSettlementIntent] = {}
+        self._load()
+
+    def _load(self) -> None:
+        raw = self.file_path.read_text(encoding="utf-8")
+        if not raw.strip():
+            return
+        for index, line in enumerate(raw.splitlines(), start=1):
+            try:
+                parsed = json.loads(line)
+                intent = CourierSettlementIntent.model_validate(parsed["intent"])
+                stored_hash = str(parsed["intent_hash"])
+                statement_id = str(parsed["statement_id"])
+                status = str(parsed["status"])
+            except Exception as exc:
+                raise CourierSettlementIntegrityError(
+                    f"CORRUPT_SETTLEMENT_INTENT_LINE:{index}"
+                ) from exc
+
+            computed = intent_hash(intent)
+            if (
+                statement_id != intent.statement_id
+                or stored_hash != computed
+                or status != "SHADOW_RECEIVED"
+            ):
+                raise CourierSettlementIntegrityError(
+                    f"SETTLEMENT_INTENT_INTEGRITY:{index}"
+                )
+            if statement_id in self._records:
+                raise CourierSettlementIntegrityError(
+                    f"DUPLICATE_SETTLEMENT_INTENT:{statement_id}"
+                )
+            self._records[statement_id] = StoredSettlementIntent(
+                statement_id=statement_id,
+                intent_hash=stored_hash,
+                intent=intent.model_dump(mode="json"),
+                status=status,
+            )
+
+    def append(
+        self,
+        intent: CourierSettlementIntent,
+    ) -> tuple[StoredSettlementIntent, bool]:
+        digest = intent_hash(intent)
+        existing = self._records.get(intent.statement_id)
+        if existing:
+            if existing.intent_hash != digest:
+                raise CourierSettlementConflict(
+                    "ORCHIDPAY_COURIER_SETTLEMENT_STATEMENT_CONFLICT"
+                )
+            return existing, True
+
+        stored = StoredSettlementIntent(
+            statement_id=intent.statement_id,
+            intent_hash=digest,
+            intent=intent.model_dump(mode="json"),
+            status="SHADOW_RECEIVED",
+        )
+        line = json.dumps(
+            {
+                "statement_id": stored.statement_id,
+                "intent_hash": stored.intent_hash,
+                "status": stored.status,
+                "intent": stored.intent,
+            },
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+        )
+        descriptor = os.open(self.file_path, os.O_APPEND | os.O_WRONLY)
+        try:
+            os.write(descriptor, (line + "\n").encode("utf-8"))
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+        os.chmod(self.file_path, 0o600)
+        self._records[stored.statement_id] = stored
+        return stored, False
+
+    def get(self, statement_id: str) -> StoredSettlementIntent | None:
+        return self._records.get(str(statement_id).strip())
+
+
+class CourierSettlementShadowService:
+    def __init__(self, store: ShadowCourierSettlementIntentStore):
+        self.store = store
+
+    def accept(self, intent: CourierSettlementIntent) -> CourierSettlementReceipt:
+        stored, replay = self.store.append(intent)
+        return CourierSettlementReceipt(
+            statement_id=stored.statement_id,
+            intent_hash=stored.intent_hash,
+            idempotent_replay=replay,
+        )
+
+    def get(self, statement_id: str) -> StoredSettlementIntent | None:
+        return self.store.get(statement_id)
+
+    def outbox_preview(self, statement_id: str) -> dict[str, Any]:
+        stored = self.store.get(statement_id)
+        if not stored:
+            raise KeyError("ORCHIDPAY_COURIER_SETTLEMENT_NOT_FOUND")
+        event_id = hashlib.sha256(
+            f"courier-payroll-shadow:{statement_id}".encode("utf-8")
+        ).hexdigest()
+        return {
+            "id": event_id,
+            "topic": "courier.payroll.settlement.shadow",
+            "event_type": "CourierPayrollSettlementIntentShadowReceived",
+            "event_key": statement_id,
+            "payload": {
+                "statement_id": statement_id,
+                "intent_hash": stored.intent_hash,
+                "status": stored.status,
+                "production_execution": False,
+            },
+        }
